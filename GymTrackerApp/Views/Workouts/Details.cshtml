@using GymTrackerApp.ViewModels.ViewModels.Workout
@model WorkoutDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-hover-lift rounded-pill px-4 fw-bold text-white shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Back to Workouts
        </a>
    </div>

    <div class="row align-items-center mb-5 gx-5">
        <div class="col-lg-7 mb-4 mb-lg-0">
            <h1 class="display-4 fw-bolder text-gradient mb-3" style="letter-spacing: -1px;">@Model.Title</h1>
            <p class="fs-5 text-white-50 lh-lg mb-4">@Model.Description</p>
            
            @if (Model.LatestSession != null)
            {
                <span class="badge bg-dark border border-secondary text-light rounded-pill px-4 py-2 fs-6 shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-info"></i>
                    Last Session: @Model.LatestSession.DateCompleted.ToString("MMM dd, yyyy")
                    <span class="text-white-50 ms-1 fw-normal">(@Model.LatestSession.DurationInMinutes min)</span>
                </span>
            }
            else
            {
                <span class="badge bg-dark border border-secondary text-white-50 rounded-pill px-4 py-2 fs-6 shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-clock text-secondary"></i>
                    No sessions logged yet
                </span>
            }
        </div>
    </div>

    <div class="card bg-dark border-secondary shadow-lg mb-5 rounded-4 overflow-hidden">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 bg-opacity-10" style="background-color: rgba(13, 202, 240, 0.02);">
            
            <form asp-controller="Sessions" asp-action="LogSession" method="post" class="m-0 d-flex flex-wrap align-items-center gap-3">
                <input type="hidden" name="WorkoutId" value="@Model.Id" />
                
                <div class="d-flex align-items-center text-white fw-bold fs-5 me-2">
                    <i class="bi bi-stopwatch text-success me-2 fs-4"></i> Log Time:
                </div>

                <div class="input-group shadow-sm" style="width: 150px;">
                    <input type="number" name="DurationInMinutes" class="form-control bg-secondary text-white border-success border-opacity-50 text-center fw-bold fs-5" value="60" min="1" max="500" title="Duration in minutes" />
                    <span class="input-group-text bg-dark text-success border-success border-opacity-50 fw-bold">
                        min
                    </span>
                </div>

                <button type="submit" class="btn btn-success btn-lg fw-bold px-4 pulse-button rounded-pill shadow btn-hover-lift">
                    <i class="bi bi-check-circle-fill me-1"></i> Finish
                </button>
            </form>

            <div class="border-start border-secondary ps-md-4 d-none d-md-block" style="height: 40px;"></div>

            <a asp-controller="Workouts" asp-action="AddExercise" asp-route-id="@Model.Id" class="btn btn-info btn-lg fw-bold px-4 rounded-pill shadow-sm btn-hover-lift text-dark w-100 w-md-auto text-center">
                <i class="bi bi-plus-lg me-1"></i> Add Exercise
            </a>
            
        </div>
    </div>

    <h3 class="text-white fw-bold mb-4"><i class="bi bi-card-list text-info me-2"></i> Routine Details</h3>

    @if (!Model.Exercises.Any())
    {
        <div class="empty-state-dashed p-5 text-center text-white-50 mt-2 shadow-sm">
            <i class="bi bi-clipboard-x mb-3 d-block text-secondary" style="font-size: 4rem;"></i>
            <h4 class="text-white fw-bold">This workout is empty.</h4>
            <p class="lead mb-4">You haven't added any exercises to this routine yet.</p>
            <a asp-controller="Workouts" asp-action="AddExercise" asp-route-id="@Model.Id" class="btn btn-outline-info rounded-pill px-4 btn-hover-lift fw-bold">
                <i class="bi bi-search me-1"></i> Browse Library to Add
            </a>
        </div>
    }
    else
    {
        <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 text-white border-secondary">
                    <thead class="bg-secondary bg-opacity-25 border-bottom border-secondary">
                        <tr class="text-white-50" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">
                            <th class="ps-4 py-3 fw-normal">Exercise</th>
                            <th class="py-3 fw-normal">Target</th>
                            <th class="text-center py-3 fw-normal">Sets</th>
                            <th class="text-center py-3 fw-normal">Reps</th>
                            <th class="text-center py-3 fw-normal">Weight</th>
                            <th class="text-end pe-4 py-3 fw-normal">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Exercises)
                        {
                            <tr class="border-bottom border-secondary" style="border-color: rgba(255,255,255,0.05) !important;">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ExerciseImageUrl))
                                        {
                                            <img src="@item.ExerciseImageUrl" class="rounded-3 shadow-sm border border-secondary" style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 shadow-sm border border-secondary bg-secondary d-flex justify-content-center align-items-center text-white-50" style="width: 50px; height: 50px;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <span class="fw-bold fs-5 text-light">@item.ExerciseName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary border border-light shadow-sm px-3 py-2 rounded-pill">@item.MuscleName</span>
                                </td>
                                <td class="text-center fs-5 fw-bold text-info">@item.Sets</td>
                                <td class="text-center fs-5 fw-bold text-info">@item.Reps</td>
                                <td class="text-center">
                                    <span class="badge bg-dark border border-secondary text-white-50 px-3 py-2 fs-6 shadow-sm">
                                        @item.Weight kg
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="RemoveExercise" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to remove @item.ExerciseName from this workout?');">
                                        <input type="hidden" name="workoutId" value="@Model.Id" />
                                        <input type="hidden" name="exerciseId" value="@item.ExerciseId" />
                                        <button type="submit" class="btn btn-outline-danger rounded-circle btn-hover-lift shadow-sm d-inline-flex justify-content-center align-items-center" style="width: 40px; height: 40px;" title="Remove Exercise">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>