@using GymTrackerApp.ViewModels.ViewModels.Workout
@model IEnumerable<WorkoutViewModel>

@{
    ViewData["Title"] = "My Workouts";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 border-bottom border-secondary pb-4 text-white gap-3">
    <h1 class="fw-bold mb-0">
        <i class="bi bi-journal-check text-info me-2"></i>
        <span class="text-gradient">@ViewData["Title"]</span>
    </h1>
    <a asp-action="Create" class="btn btn-info fw-bold rounded-pill px-4 py-2 shadow-sm btn-hover-lift text-dark">
        <i class="bi bi-plus-lg me-1"></i> Create New Workout
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state-dashed p-5 text-center text-white-50 mt-4 shadow-sm">
        <i class="bi bi-clipboard-x mb-3 d-block text-secondary" style="font-size: 5rem;"></i>
        <h2 class="text-white fw-bold">Your routine is empty.</h2>
        <p class="lead mb-4">You haven't created any custom workout plans yet. Build your first routine to start tracking your progress!</p>
        
        <a asp-action="Create" class="btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold text-dark pulse-button btn-hover-lift shadow">
            <i class="bi bi-lightning-charge-fill text-dark me-1"></i> Build Your First Workout
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var workout in Model)
        {
            <div class="col">
                <div class="card h-100 feature-card shadow position-relative overflow-hidden">
                    
                    <i class="bi bi-activity position-absolute" style="font-size: 10rem; color: rgba(255,255,255,0.02); top: -15%; right: -10%; z-index: 0; pointer-events: none;"></i>

                    <div class="card-body p-4 position-relative" style="z-index: 1;">
                        <h3 class="card-title text-white fw-bold mb-3">@workout.Title</h3>
                        
                        @if (!string.IsNullOrWhiteSpace(workout.Description))
                        {
                            <p class="card-text text-white-50 lh-lg" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @workout.Description
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-secondary fst-italic">No description provided.</p>
                        }
                    </div>

                    <div class="card-footer bg-transparent border-top border-secondary p-3 position-relative" style="z-index: 1;">
                        <div class="d-flex gap-2">
                            
                            <a asp-action="Details" asp-route-id="@workout.Id" class="btn btn-outline-info flex-grow-1 fw-bold rounded-3 btn-hover-lift">
                                <i class="bi bi-eye me-1"></i> View Routine
                            </a>
                            
                            <a asp-action="Edit" asp-route-id="@workout.Id" class="btn btn-warning rounded-3 btn-hover-lift" title="Edit Name/Description">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <form asp-action="Delete" asp-route-id="@workout.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this workout? All tracked sessions tied to this workout will also be affected.');">
                                <button type="submit" class="btn btn-danger rounded-3 btn-hover-lift" title="Delete Workout">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                            
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}