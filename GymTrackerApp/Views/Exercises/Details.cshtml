@using GymTrackerApp.ViewModels.ViewModels.Exercise;
@using System.Security.Claims
@model ExerciseViewModel

@{
    ViewData["Title"] = Model.Name + " - Details";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible shadow-sm fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4 mb-5">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3 border-bottom border-secondary pb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg btn-hover-lift rounded-pill px-5 fw-bold text-white shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Back to Library
            </a>
        </div>
        
        @if (currentUserId == Model.CreatorId || User.IsInRole("Admin"))
        {
            <div class="d-flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg btn-hover-lift rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-pencil-square me-2"></i> Edit
                </a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this exercise? This action cannot be undone.');">
                    <button type="submit" class="btn btn-danger btn-lg btn-hover-lift rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-trash3 me-2"></i> Delete
                    </button>
                </form>
            </div>
        }
    </div>

    <div class="row gx-5 align-items-start">
        
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="rounded-4 shadow-lg overflow-hidden border border-secondary bg-dark position-relative" style="height: 400px; width: 100%;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    /* object-fit: cover ensures the image fills the 400px box perfectly without being massive */
                    <img src="@Model.ImageUrl" class="w-100 h-100" alt="@Model.Name" style="object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                }
                else
                {
                    <div class="d-flex flex-column justify-content-center align-items-center h-100 w-100 text-white-50" style="background: linear-gradient(135deg, #212529 0%, #121416 100%);">
                        <i class="bi bi-image mb-3" style="font-size: 5rem; opacity: 0.5;"></i>
                        <h4 class="fw-bold">No Image Provided</h4>
                    </div>
                }
                
                <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                    <span class="badge bg-info text-dark fs-6 shadow px-3 py-2 rounded-pill d-inline-flex align-items-center gap-2 btn-hover-lift">
                        <i class="bi bi-bullseye"></i> Target: @Model.MuscleName
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            
            <h1 class="display-4 fw-bolder text-gradient mb-4" style="letter-spacing: -1px;">@Model.Name</h1>
            
            <div class="card bg-dark text-white border-secondary shadow-lg exercise-card">
                <div class="card-header bg-transparent border-secondary p-4 d-flex align-items-center gap-3">
                    <div class="bg-info rounded-circle d-flex justify-content-center align-items-center shadow-sm" style="width: 45px; height: 45px;">
                        <i class="bi bi-journal-text fs-4 text-dark"></i>
                    </div>
                    <h4 class="mb-0 text-white fw-bold">Execution Instructions</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-opacity-10" style="background-color: rgba(0,0,0,0.2);">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="fs-5 lh-lg text-light mb-0" style="white-space: pre-wrap; font-weight: 400;">@Model.Description</p>
                    }
                    else
                    {
                        <p class="text-white-50 fst-italic mb-0">No specific instructions have been provided for this exercise.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>