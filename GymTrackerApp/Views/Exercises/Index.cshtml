@using GymTrackerApp.ViewModels.ViewModels.Exercise
@using System.Security.Claims
@model IEnumerable<ExerciseViewModel>

@{
    ViewData["Title"] = "Exercise Library";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-5 text-white">
    <h1 class="fw-bold mb-0">
        <i class="bi bi-collection-play text-info me-2"></i> 
        <span class="text-gradient">@ViewData["Title"]</span>
    </h1>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a asp-action="Add" class="btn btn-info fw-bold rounded-pill px-4 shadow-sm btn-hover-lift text-dark">
            <i class="bi bi-plus-lg"></i> Add New Exercise
        </a>
    }
</div>

@if (!Model.Any() && string.IsNullOrEmpty(ViewBag.Search))
{
    <div class="empty-state-dashed p-5 text-center text-white-50 mt-4">
        <i class="bi bi-folder-x mb-3 d-block text-secondary" style="font-size: 4rem;"></i>
        <h3 class="text-white">No exercises found.</h3>
        <p class="lead">Be the first to add an exercise to the library!</p>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-action="Add" class="btn btn-outline-info mt-2 rounded-pill px-4 btn-hover-lift">Create Exercise</a>
        }
    </div>
}
else
{
    <form method="get" asp-action="Index" class="mb-5">
        <div class="input-group search-container border border-secondary shadow-sm bg-dark">
            <span class="input-group-text bg-transparent border-0 text-info ps-4">
                <i class="bi bi-search fs-5"></i>
            </span>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control search-input bg-transparent text-white py-3 ps-2"
                   placeholder="Search exercises by name..." />

            <button type="submit" class="btn btn-info fw-bold px-4">Search</button>

            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center px-4">Clear</a>
            }
        </div>
    </form>
    
    @if (!Model.Any() && !string.IsNullOrEmpty(ViewBag.Search))
    {
        <div class="text-center text-white-50 py-5">
            <i class="bi bi-search mb-3 d-block text-secondary" style="font-size: 3rem;"></i>
            <h5>No exercises match "@ViewBag.Search"</h5>
            <a asp-action="Index" class="text-info text-decoration-none mt-2 d-inline-block">Clear search filter</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var exercise in Model)
            {
                <div class="col">
                    <div class="card h-100 exercise-card shadow">

                        <div class="exercise-card-img-container bg-dark">
                            @if (!string.IsNullOrEmpty(exercise.ImageUrl))
                            {
                                <img src="@exercise.ImageUrl" class="exercise-card-img" alt="@exercise.Name">
                            }
                            else
                            {
                                <div class="exercise-card-img d-flex justify-content-center align-items-center bg-secondary text-white-50">
                                    <i class="bi bi-image" style="font-size: 4rem;"></i>
                                </div>
                            }
                        </div>

                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="card-title text-white fw-bold mb-0">@exercise.Name</h4>
                                <span class="badge bg-info text-dark shadow-sm">@exercise.MuscleName</span>
                            </div>
                            <p class="card-text text-white-50 lh-lg" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @exercise.Description
                            </p>
                        </div>

                        <div class="card-footer bg-transparent border-top border-secondary p-3">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-outline-info flex-grow-1 fw-bold rounded-3 btn-hover-lift">
                                    <i class="bi bi-info-circle me-1"></i> Details
                                </a>
                                
                                @if (currentUserId == exercise.CreatorId || User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-warning rounded-3 btn-hover-lift" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@exercise.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this exercise?');">
                                        <button type="submit" class="btn btn-danger rounded-3 btn-hover-lift" title="Delete">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
        
        @if (totalPages > 1)
        {
            <nav aria-label="Exercise library pagination" class="mt-5 pt-3">
                <ul class="pagination justify-content-center shadow-sm">
                    
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link bg-dark text-info border-secondary fw-bold"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@ViewBag.Search">
                            <i class="bi bi-chevron-left small"></i> Prev
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link @(currentPage == i ? "bg-info text-dark border-info fw-bold" : "bg-dark text-info border-secondary fw-bold")" 
                               asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link bg-dark text-info border-secondary fw-bold" 
                           asp-action="Index" 
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@ViewBag.Search">
                            Next <i class="bi bi-chevron-right small"></i>
                        </a>
                    </li>
                </ul>
                
                <div class="text-center text-white-50 mt-3 small fw-bold">
                    Page @currentPage of @totalPages
                </div>
            </nav>
        }
    }
}