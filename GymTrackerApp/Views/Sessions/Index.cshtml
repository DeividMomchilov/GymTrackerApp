@using GymTrackerApp.ViewModels.ViewModels.Session
@model IEnumerable<WorkoutSessionViewModel>

@{
    ViewData["Title"] = "Workout History";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4 text-white">
    <h1><i class="bi bi-clock-history"></i> @ViewData["Title"]</h1>
</div>

<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-dark text-info border-secondary">
            <i class="bi bi-search"></i>
        </span>
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control bg-dark text-white border-secondary"
               placeholder="Search by workout title..." />

        <button type="submit" class="btn btn-info fw-bold">Search</button>

        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center">
        <h4>No workout sessions found.</h4>
        <p>Go to your workouts and log a session to see it here!</p>
        <a asp-controller="Workouts" asp-action="Index" class="btn btn-info mt-2">Go to Workouts</a>
    </div>
}
else
{
    <div class="table-responsive bg-dark rounded shadow-sm border border-secondary p-3">
        <table class="table table-dark table-hover mb-0 text-center align-middle">
            <thead>
                <tr>
                    <th class="text-info">Workout Title</th>
                    <th class="text-info">Date Completed</th>
                    <th class="text-info">Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model)
                {
                    <tr>
                        <td class="fw-bold">@session.WorkoutTitle</td>
                        <td>@session.DateCompleted.ToString("g")</td>
                        <td>
                            <span class="badge bg-secondary">
                                <i class="bi bi-stopwatch"></i> @session.DurationInMinutes min
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Sessions pagination" class="mt-5">
            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link bg-dark text-info border-secondary"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@ViewBag.Search">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link @(currentPage == i ? "bg-info text-dark border-info" : "bg-dark text-info border-secondary")"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link bg-dark text-info border-secondary"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@ViewBag.Search">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>

            <div class="text-center text-white-50 mt-2 small">
                Page @currentPage of @totalPages
            </div>
        </nav>
    }
}