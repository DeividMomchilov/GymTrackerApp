@using GymTrackerApp.ViewModels.ViewModels.Session
@model IEnumerable<WorkoutSessionViewModel>

@{
    ViewData["Title"] = "Workout History";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 border-bottom border-secondary pb-4 text-white gap-3">
    <h1 class="fw-bold mb-0">
        <i class="bi bi-clock-history text-info me-2"></i>
        <span class="text-gradient">@ViewData["Title"]</span>
    </h1>
    <a asp-controller="Workouts" asp-action="Index" class="btn btn-outline-light fw-bold rounded-pill px-4 py-2 shadow-sm btn-hover-lift">
        <i class="bi bi-play-fill me-1"></i> Start a Workout
    </a>
</div>

@if (!Model.Any() && string.IsNullOrEmpty(ViewBag.Search))
{
    <div class="empty-state-dashed p-5 text-center text-white-50 mt-4 shadow-sm">
        <i class="bi bi-calendar-x mb-3 d-block text-secondary" style="font-size: 5rem;"></i>
        <h2 class="text-white fw-bold">No sessions logged yet.</h2>
        <p class="lead mb-4">You haven't completed any workouts. Head over to your routines, hit finish, and watch your history grow!</p>
        
        <a asp-controller="Workouts" asp-action="Index" class="btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold text-dark pulse-button btn-hover-lift shadow">
            <i class="bi bi-lightning-charge-fill text-dark me-1"></i> Go to Workouts
        </a>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="mb-5">
        <div class="input-group search-container border border-secondary shadow-sm bg-dark">
            <span class="input-group-text bg-transparent border-0 text-info ps-4">
                <i class="bi bi-search fs-5"></i>
            </span>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control search-input bg-transparent text-white py-3 ps-2"
                   placeholder="Search by workout title..." />

            <button type="submit" class="btn btn-info fw-bold px-4">Search</button>

            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center px-4">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Any() && !string.IsNullOrEmpty(ViewBag.Search))
    {
        <div class="text-center text-white-50 py-5 my-5">
            <i class="bi bi-search mb-3 d-block text-secondary" style="font-size: 4rem;"></i>
            <h4 class="text-white">No sessions match "@ViewBag.Search"</h4>
            <p>Try searching for a different workout title.</p>
            <a asp-action="Index" class="btn btn-outline-info rounded-pill px-4 mt-2 btn-hover-lift">Clear search filter</a>
        </div>
    }
    else
    {
        <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden mb-5">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 text-white border-secondary text-center">
                    <thead class="bg-secondary bg-opacity-25 border-bottom border-secondary">
                        <tr class="text-white-50" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">
                            <th class="ps-4 py-3 fw-normal text-start">Workout Title</th>
                            <th class="py-3 fw-normal">Date Completed</th>
                            <th class="pe-4 py-3 fw-normal text-end">Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            <tr class="border-bottom border-secondary" style="border-color: rgba(255,255,255,0.05) !important;">
                                <td class="ps-4 py-4 text-start">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-dark border border-secondary rounded-circle d-flex justify-content-center align-items-center shadow-sm" style="width: 45px; height: 45px;">
                                            <i class="bi bi-check2-all text-success fs-5"></i>
                                        </div>
                                        <span class="fw-bold fs-5 text-light">@session.WorkoutTitle</span>
                                    </div>
                                </td>
                                <td class="py-4">
                                    <span class="text-light fs-6">@session.DateCompleted.ToString("MMM dd, yyyy")</span>
                                    <br />
                                    <small class="text-white-50">@session.DateCompleted.ToString("HH:mm")</small>
                                </td>
                                <td class="pe-4 py-4 text-end">
                                    <span class="badge bg-info text-dark px-3 py-2 fs-6 shadow-sm rounded-pill border border-info fw-bold">
                                        <i class="bi bi-stopwatch-fill me-1"></i> @session.DurationInMinutes min
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Sessions pagination" class="mt-5 pt-3">
                <ul class="pagination justify-content-center shadow-sm">

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link bg-dark text-info border-secondary fw-bold"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-search="@ViewBag.Search">
                            <i class="bi bi-chevron-left small"></i> Prev
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link @(currentPage == i ? "bg-info text-dark border-info fw-bold" : "bg-dark text-info border-secondary fw-bold")"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link bg-dark text-info border-secondary fw-bold"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-search="@ViewBag.Search">
                            Next <i class="bi bi-chevron-right small"></i>
                        </a>
                    </li>
                </ul>

                <div class="text-center text-white-50 mt-3 small fw-bold">
                    Page @currentPage of @totalPages
                </div>
            </nav>
        }
    }
}