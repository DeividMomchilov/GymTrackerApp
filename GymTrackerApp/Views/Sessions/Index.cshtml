@using GymTrackerApp.ViewModels.ViewModels.Session;
@model IEnumerable<WorkoutSessionViewModel>

@{
    ViewData["Title"] = "Workout History";
}

<div class="d-flex justify-content-between align-items-center mb-4 text-white">
    <h1><i class="bi bi-clock-history text-success"></i> My History</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center shadow-sm border-secondary">
        <h4>No completed workouts yet.</h4>
        <p>Go to "My Workouts" and finish a session to see it here!</p>
        <a asp-controller="Workouts" asp-action="Index" class="btn btn-primary mt-2">Go to Workouts</a>
    </div>
}
else
{
    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="table-active border-secondary">
                        <tr>
                            <th class="ps-4">Workout</th>
                            <th>Date Completed</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            <tr class="border-secondary">
                                <td class="ps-4 fw-bold text-info">@session.WorkoutTitle</td>
                                <td>@session.DateCompleted.ToString("f")</td>
                                <td><span class="badge bg-secondary">@session.DurationInMinutes min</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}