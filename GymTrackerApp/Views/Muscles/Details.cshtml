@using GymTrackerApp.ViewModels.ViewModels.Muscle
@model MuscleDetailsViewModel

@{
    ViewData["Title"] = Model.Name + " Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold text-white">
        <i class="bi bi-arrow-left"></i> Back to Muscles
    </a>
</div>

<div class="row mb-5 align-items-center">
    <div class="col-md-5 mb-4 mb-md-0">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-lg border border-info" alt="@Model.Name" style="max-height: 400px; width: 100%; object-fit: cover;" />
        }
        else
        {
            <div class="rounded shadow-lg border border-info bg-secondary d-flex align-items-center justify-content-center" style="height: 300px; width: 100%;">
                <i class="bi bi-image text-white-50" style="font-size: 4rem;"></i>
            </div>
        }
    </div>
    
    <div class="col-md-7 text-white">
        <h1 class="fw-bold mb-3 text-info" style="font-size: 3rem;">@Model.Name</h1>
        <div class="p-4 bg-dark rounded shadow-sm border border-secondary">
            <h4 class="text-white-50 mb-3"><i class="bi bi-info-circle"></i> Anatomical Overview</h4>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="fs-5 lh-base m-0">@Model.Description</p>
            }
            else
            {
                <p class="text-muted fst-italic m-0">No description provided for this muscle group.</p>
            }
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-area="Admin" asp-controller="Muscles" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">
                <i class="bi bi-pencil-square"></i> Edit Muscle Data
            </a>
        }
    </div>
</div>

<hr class="border-secondary mb-5" />

<h2 class="text-white mb-4"><i class="bi bi-list-check"></i> Exercises Targeting @Model.Name</h2>

@if (!Model.Exercises.Any())
{
    <div class="alert alert-secondary text-center">
        <h4>No exercises found for @Model.Name.</h4>
        <p>Be the first to add an exercise targeting this muscle group!</p>
        <a asp-controller="Exercises" asp-action="Add" class="btn btn-info mt-2">Add New Exercise</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var exercise in Model.Exercises)
        {
            <div class="col">
                <div class="card h-100 bg-dark text-white border-secondary shadow-sm">
                    @if (!string.IsNullOrEmpty(exercise.ImageUrl))
                    {
                        <img src="@exercise.ImageUrl" class="card-img-top" alt="@exercise.Name" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@exercise.Name</h5>
                        <p class="card-text text-white-50 text-truncate" style="max-height: 3rem;">@exercise.Description</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pb-3 pt-0">
                        <a asp-controller="Exercises" asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-outline-info w-100 fw-bold">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}