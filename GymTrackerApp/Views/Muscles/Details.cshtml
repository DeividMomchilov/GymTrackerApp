@using System.Security.Claims
@using GymTrackerApp.ViewModels.ViewModels.Muscle
@model MuscleDetailsViewModel

@{
    ViewData["Title"] = Model.Name + " Exercises";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="mb-4 text-white">
    <h1 class="text-info"><i class="bi bi-activity"></i> @Model.Name Exercises</h1>
    <p class="text-white-50 fs-5">Browse all exercises targeting the @Model.Name.</p>
</div>

@if (!Model.Exercises.Any())
{
    <div class="alert alert-secondary text-center shadow-sm border-secondary">
        <h4>No exercises found for this muscle group.</h4>
        <a asp-controller="Exercises" asp-action="Add" class="btn btn-primary mt-3">Be the first to add one!</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var exercise in Model.Exercises)
        {
            <div class="col">
                <div class="card h-100 bg-dark text-white border-secondary shadow">

                    @if (!string.IsNullOrEmpty(exercise.ImageUrl))
                    {
                        <img src="@exercise.ImageUrl" class="card-img-top" alt="@exercise.Name" style="height: 200px; object-fit: cover; border-bottom: 1px solid #495057;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px; border-bottom: 1px solid #495057;">
                            <span class="fs-1"><i class="bi bi-image"></i></span>
                        </div>
                    }

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title text-info fw-bold">@exercise.Name</h5>
                        </div>
                        <p class="card-text text-white-50 small text-truncate">@exercise.Description</p>
                    </div>

                    <div class="card-footer bg-transparent border-top border-secondary">
                        <div class="d-flex gap-2">
                            <a asp-controller="Exercises" asp-action="Details" asp-route-id="@exercise.Id" class="btn btn-outline-info flex-grow-1">
                                <i class="bi bi-info-circle"></i> Details
                            </a>

                            @if (currentUserId == exercise.CreatorId)
                            {
                                <a asp-controller="Exercises" asp-action="Edit" asp-route-id="@exercise.Id" class="btn btn-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Exercises" asp-action="Delete" asp-route-id="@exercise.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this exercise?');">
                                    <button type="submit" class="btn btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-light">
        <i class="bi bi-arrow-left"></i> Back to Muscle Groups
    </a>
</div>