<header>
    <partial name="_NotificationPartial" />
    
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm mb-4 py-3 sticky-top">
        <div class="container">
            
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-activity fs-3 text-info"></i>
                <span class="brand-text">GymTracker</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between mt-3 mt-lg-0">
                    
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Exercises" asp-action="Index">
                                <i class="bi bi-collection"></i> Exercises
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Muscles" asp-action="Index">
                                <i class="bi bi-universal-access"></i> Muscles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Workouts" asp-action="Index">
                                <i class="bi bi-clipboard-check"></i> Workouts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Sessions" asp-action="Index">
                                <i class="bi bi-stopwatch"></i> Sessions
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center justify-content-lg-end gap-3">
                        
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge border border-warning text-warning bg-dark px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2"
                              style="font-size: 0.85rem; cursor: default; user-select: none; transition: all 0.3s ease;"
                              onmouseover="this.style.boxShadow='0 0 10px rgba(255, 193, 7, 0.4)'"
                              onmouseout="this.style.boxShadow='none'">
                            <i class="bi bi-shield-lock-fill"></i> Admin
                        </span>
                    }

                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </nav>
</header>