@{
    ViewData["Title"] = "404 - Not Found";
}

<div class="container d-flex flex-column justify-content-center align-items-center mt-5 text-center text-white" style="min-height: 60vh;">
    <h1 class="display-1 fw-bolder text-info mb-0">404</h1>
    <h2 class="mb-4 fw-bold">Oops! This page skipped leg day.</h2>
    <p class="lead text-white-50 mb-5" style="max-width: 600px;">
        The page you are looking for doesn't exist, has been moved, or is currently taking a rest day. Let's get you back to your routine.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-info btn-lg shadow-sm text-dark fw-bold">
        <i class="bi bi-house-door-fill"></i> Back to the Gym
    </a>
</div>