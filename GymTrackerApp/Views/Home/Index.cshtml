@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center hero-section p-5 mb-5 rounded-3 shadow-lg position-relative">
    <i class="bi bi-activity position-absolute" style="font-size: 25rem; color: rgba(255,255,255,0.02); top: -10%; right: -5%; z-index: 0; pointer-events: none;"></i>
    
    <div class="position-relative py-5" style="z-index: 1;">
        <h1 class="display-3 fw-bold text-white mb-3">
            Welcome to <span class="text-info">GymTracker</span>
        </h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 600px;">
            The ultimate tool to build routines, track your sessions, and master your anatomy. Log your progress and crush your fitness goals.
        </p>
        
        <div class="mt-5 gap-3 d-flex justify-content-center flex-wrap">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="Workouts" asp-action="Index" class="btn btn-info btn-lg fw-bold pulse-button px-5 rounded-pill shadow">
                    <i class="bi bi-play-fill"></i> Start Workout
                </a>
                <a asp-controller="Exercises" asp-action="Index" class="btn btn-outline-light btn-lg fw-bold px-5 rounded-pill">
                    <i class="bi bi-search"></i> Browse Exercises
                </a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-info btn-lg fw-bold pulse-button px-5 rounded-pill shadow">
                    <i class="bi bi-lightning-charge-fill"></i> Get Started Free
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg fw-bold px-5 rounded-pill">
                    <i class="bi bi-box-arrow-in-right"></i> Log In
                </a>
            }
        </div>
    </div>
</div>

<div class="container px-4 py-3" id="features">
    <div class="row g-4 py-4 row-cols-1 row-cols-lg-3">
        
        <div class="col">
            <div class="feature-card h-100 p-4 text-center text-white d-flex flex-column align-items-center">
                <div class="mb-3">
                    <i class="bi bi-card-checklist feature-icon"></i>
                </div>
                <h3 class="fs-4 fw-bold">Custom Workouts</h3>
                <p class="text-white-50 mb-0 mt-2">
                    Design and organize your own workout routines. Combine your favorite exercises to create the perfect split.
                </p>
            </div>
        </div>

        <div class="col">
            <div class="feature-card h-100 p-4 text-center text-white d-flex flex-column align-items-center">
                <div class="mb-3">
                    <i class="bi bi-stopwatch feature-icon"></i>
                </div>
                <h3 class="fs-4 fw-bold">Session Tracking</h3>
                <p class="text-white-50 mb-0 mt-2">
                    Log your real-time workout sessions, track your duration, and monitor your consistency over time.
                </p>
            </div>
        </div>

        <div class="col">
            <div class="feature-card h-100 p-4 text-center text-white d-flex flex-column align-items-center">
                <div class="mb-3">
                    <i class="bi bi-universal-access feature-icon"></i>
                </div>
                <h3 class="fs-4 fw-bold">Anatomy Insights</h3>
                <p class="text-white-50 mb-0 mt-2">
                    Browse a comprehensive library of exercises. Filter by muscle group and master the anatomy behind every lift.
                </p>
            </div>
        </div>

    </div>
</div>